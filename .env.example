# Discord Bot Configuration (OBLIGATOIRE)
DISCORD_TOKEN=your_discord_token
DISCORD_CLIENT_ID=your_client_id
NODE_ENV=production

# PostgreSQL (OBLIGATOIRE - persistance)
# En Docker, POSTGRES_HOST = "postgres" (nom du service compose).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dn_discord_bot
POSTGRES_USER=botuser
POSTGRES_PASSWORD=change_me

# APIs Externes (OPTIONNEL - pour /stats trending)
STEAM_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
RAWG_API_KEY=

# Configuration Votes
DEFAULT_VOTE_GAMES_COUNT=10
DEFAULT_VOTE_DURATION=24

# Logs
LOG_LEVEL=info
