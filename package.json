{
  "name": "discord-bot-template-ts",
  "version": "1.1.0",
  "description": "A Discord bot template with TypeScript, featuring advanced command system and modern development practices",
  "main": "dist/app.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "start:deploy": "npm run deploy:commands:built && npm start",
    "dev": "tsx watch src/app.ts",
    "dev:build": "tsc --watch",
    "deploy:commands": "tsx src/deploy-commands.ts",
    "deploy:commands:built": "node dist/deploy-commands.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist coverage",
    "prebuild": "npm run clean",
    "migrate": "node scripts/migrate.cjs",
    "migrate:create": "node scripts/migrate.cjs create",
    "migrate:up": "node scripts/migrate.cjs up",
    "migrate:down": "node scripts/migrate.cjs down",
    "migrate:redo": "node scripts/migrate.cjs redo",
    "prepare": "husky || true"
  },
  "keywords": [
    "discord",
    "bot",
    "template",
    "typescript",
    "discord.js"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.17.0",
    "dotenv": "^16.4.5",
    "node-cron": "^4.2.1",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.0",
    "@types/node": "^26.1.1",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.8",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
